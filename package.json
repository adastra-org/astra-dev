{
  "name": "astra-dev",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "tokens": "bun scripts/tokens.ts && oxfmt src/styles/tokens.css",
    "import": "bun scripts/import/run.ts",
    "import:update": "bun scripts/import/run.ts update",
    "test": "bun test --pass-with-no-tests src scripts",
    "check:server": "bun run --cwd server check",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run check:server"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/averia-serif-libre": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@johnnymorganz/stylua": "^2.6.0",
    "animejs": "^4.5.0",
    "luaparse": "^0.3.1",
    "lucide-react": "^1.70.0",
    "marked": "^18.2.0",
    "motion": "^14.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "wasmoon": "^1.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "yaml": "^2.9.1"
  }
}
