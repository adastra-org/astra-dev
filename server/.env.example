# Astra Dev server. Copy to server/.env (gitignored). Never commit real values.
# Full reference with defaults: docs/server/README.md. Everything not listed here has a default.

# --- Runtime ---------------------------------------------------------------
# Production unit sets NODE_ENV=production (no viewer stub, no `fake` LLM, DEEPSEEK_API_KEY required).
# NODE_ENV=production
# blue -> 4101, green -> 4102, anything else -> 4100
ASTRA_SLOT=dev
# PORT=4100
# HOST=127.0.0.1
# Trust X-Real-IP from nginx. true in production.
# TRUST_PROXY=true
ALLOWED_ORIGINS=http://localhost:5173

# --- Viewer / accounts ----------------------------------------------------
# Dev stub: skip the accounts service. Ignored in production.
# Values: public | subscriber | staff
ASTRA_DEV_VIEWER=staff
# Accounts service the session cookie is forwarded to (GET /api/auth/viewer).
# ACCOUNTS_BASE_URL=https://adastrarp.com

# --- LLM (Ask Ether) ------------------------------------------------------
# deepseek | local | fake (fake only outside production)
LLM_PROVIDER=fake
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# Secret. Required when LLM_PROVIDER=deepseek in production.
DEEPSEEK_API_KEY=

# Local OpenAI-compatible server (llama.cpp llama-server). Loopback only.
# LLM_PROVIDER=local
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=lfm

# Fallback when the primary fails before answering. Only with LLM_PROVIDER=deepseek. Loopback only.
# LLM_FALLBACK_PROVIDER=local
# LLM_FALLBACK_BASE_URL=http://127.0.0.1:8080/v1
# LLM_FALLBACK_MODEL=local

# --- Decision model (context gate + follow-up). Off when DECISION_URL is empty. Loopback only.
# DECISION_URL=http://127.0.0.1:8081
# DECISION_TIMEOUT_MS=1500
# DECISION_FOLLOWUP_THRESHOLD=0.25
# DECISION_GATE_THRESHOLD=0.5
# DECISION_GATE_FLOOR=0.3
# DECISION_GATE_FRAGMENT_CHARS=1500

# --- Embedder -------------------------------------------------------------
# EMBEDDER_URL=http://127.0.0.1:8891/v1/embeddings
# EMBEDDER_MODEL=embeddinggemma-2
# EMBEDDER_DIMS=256
# Secret. Bearer for a hosted embedder (https only).
EMBEDDER_TOKEN=

# --- Project / roadmap ----------------------------------------------------
# Secret, read-only. Without it the `project` query is off.
ASTRA_GITHUB_TOKEN=
# PROJECT_REPO=adastra-org/astra-dev
# PROJECT_REF=dev

# --- External checklist ---------------------------------------------------
# MYCHECKLIST_URL=https://checklist.wefaber.net
# MYCHECKLIST_LIST=Ad Astra
# Secret, mck_... in read mode. Without it the external list is `disabled`.
MYCHECKLIST_TOKEN=

# --- Owner role -------------------------------------------------------------
# Accounts ids (comma separated) that become `owner`: no rate limits, no daily token budget, no
# CHAT_MAX_* caps. They must ALSO be `staff` in accounts. Empty = nobody is owner.
# OWNER_IDS=
# Rounds (tool calls, subagents) in one message before the server asks the owner to continue.
# OWNER_MAX_ROUNDS=8

# --- Usage records (SQLite). Empty = none are kept. Put the file OUTSIDE the slot dirs. -----
# USAGE_DB_PATH=/home/hermes/deploy/data/astra-dev/usage.sqlite
# USAGE_RETENTION_DAYS=180
# USD per million tokens for hosted models (estimate of the cost).
# USAGE_PRICE_IN_PER_MTOK=0.14
# USAGE_PRICE_OUT_PER_MTOK=0.28
